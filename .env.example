# App
NEXT_PUBLIC_APP_URL=https://storelaunch.app
NODE_ENV=production

# Encryption (Must be a 64-character hex string = 32 bytes for AES-256-GCM)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Shopify Custom OAuth App (Minimal Scopes)
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_client_secret
SHOPIFY_SCOPES=read_products,read_orders,read_locales,read_legal_policies,read_online_store_pages
SHOPIFY_API_VERSION=2024-10

# LLM Provider ("openai" | "anthropic")
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# Payments: Razorpay (INR) & Stripe (USD)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend Transactional Emails
RESEND_API_KEY=re_123456789
EMAIL_FROM=StoreLaunch <launch@storelaunch.app>
